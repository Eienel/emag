# WalletConnect project ID — grab one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: ChainGPT API key for natural-language payroll prompts.
# If unset, ShadowPay falls back to a deterministic local parser.
CHAINGPT_API_KEY=

# Optional: override the iExec Nox gateway endpoint
NEXT_PUBLIC_NOX_GATEWAY=https://gateway.iex.ec/nox
