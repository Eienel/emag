DEPLOYER_PRIVATE_KEY=0x...
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBISCAN_API_KEY=

# Optional: pass an existing testnet USDC to wrap. If unset, deploy.ts
# spins up a MockERC20 (mUSDC) and seeds 1M to the deployer.
DEMO_UNDERLYING_ADDRESS=

# Optional: address that should own the payroll contract after deploy.
# Strongly recommended when DEPLOYER_PRIVATE_KEY is a disposable hot wallet
# generated for the deploy. Ownership transfers automatically if set.
FINAL_OWNER=
